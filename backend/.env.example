# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Supabase PostgreSQL (SQLAlchemy + psycopg3)
# Project display name in the dashboard can be "FacultyLink" — that is NOT the database name.
# Application database name on the same Supabase project (create via SQL if needed — see docs/CLOUD_SETUP.md).
#
# Direct connection (long-running Flask on your PC), from Dashboard → Connect → URI:
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/facultylinks?sslmode=require
#
# Session pooler (IPv4), port 5432 — use host from Connect → Session pooler:
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/facultylinks?sslmode=require
DATABASE_URL=

# Fail health checks if connected DB name does not match
EXPECTED_DATABASE_NAME=facultylinks

# Supabase project URL (Dashboard → Project Settings → API → Project URL)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Service role key — backend only; never expose to web or Flutter
SUPABASE_SERVICE_ROLE_KEY=

# Private Storage bucket (create in Dashboard → Storage; do not make public)
SUPABASE_STORAGE_BUCKET=facultylinks-documents

# Comma-separated browser origins (no trailing slash)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5000,http://localhost:5000

# Session cookie (web)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Upload limits
MAX_UPLOAD_BYTES=20971520
ALLOWED_UPLOAD_MIME=application/pdf,image/jpeg,image/png,image/webp
