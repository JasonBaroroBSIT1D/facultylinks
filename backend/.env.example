# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Supabase PostgreSQL (SQLAlchemy + psycopg3)
# Project display name in the dashboard can be "FacultyLink" — that is NOT the database name.
# Application database name on the same Supabase project (create via SQL if needed — see docs/CLOUD_SETUP.md).
#
# Direct connection (long-running Flask on your PC), from Dashboard → Connect → URI:
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/facultylinks?sslmode=require
#
# Session pooler (IPv4), port 5432 — use host from Connect → Session pooler:
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/facultylinks?sslmode=require
DATABASE_URL=

# Fail health checks if connected DB name does not match
EXPECTED_DATABASE_NAME=facultylinks

# Supabase project URL (Dashboard → Project Settings → API → Project URL)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Service role key — backend only; never expose to web or Flutter
SUPABASE_SERVICE_ROLE_KEY=

# Private Storage bucket (create in Dashboard → Storage; do not make public)
SUPABASE_STORAGE_BUCKET=facultylinks-documents

# Comma-separated browser origins (no trailing slash)
# Include Flutter web dev origins when using: flutter run -d chrome --web-port=49932
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:49932,http://localhost:49932

# Session cookie (web)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Tesseract OCR (Windows example if not on PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Upload limits
MAX_UPLOAD_BYTES=20971520
ALLOWED_UPLOAD_MIME=application/pdf,image/jpeg,image/png,image/webp

# --- Gmail SMTP (credential + password recovery emails) ---
# 1. Use a Google Account with 2-Step Verification enabled.
# 2. Create an App Password: Google Account → Security → App passwords → Mail → Other (FacultyLink).
# 3. Use smtp.gmail.com, port 587, TLS enabled (SMTP_USE_TLS=true).
# 4. MAIL_FROM is usually the same address as SMTP_USERNAME.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=FacultyLink

# Optional: separate secret for HMAC of recovery codes (defaults to SECRET_KEY if unset)
RECOVERY_HMAC_SECRET=

API_TOKEN_TTL_HOURS=168
